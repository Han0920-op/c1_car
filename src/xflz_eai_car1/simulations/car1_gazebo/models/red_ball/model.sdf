<?xml version="1.0"?>
<sdf version="1.8">
  <!-- 固定参考目标，避免滚动使画面结果不可重复。 -->
  <model name="red_ball">
    <static>true</static>
    <link name="link">
      <visual name="red_sphere">
        <geometry>
          <sphere><radius>0.035</radius></sphere>
        </geometry>
        <material>
          <ambient>0.8 0.03 0.03 1</ambient>
          <diffuse>0.9 0.03 0.03 1</diffuse>
        </material>
      </visual>
    </link>
  </model>
</sdf>
