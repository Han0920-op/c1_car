<?xml version="1.0"?>
<sdf version="1.8">
  <model name="exp01_color_targets">
    <static>true</static>
    <link name="targets">
      <!-- 球心在车体左前方分两排排列，测试目标固定在零位相机的视野内。 -->
      <visual name="red">
        <pose>0 0.17 0 0 0 0</pose>
        <geometry>
          <sphere><radius>0.035</radius></sphere>
        </geometry>
        <material>
          <ambient>0.9 0.03 0.03 1</ambient>
          <diffuse>0.9 0.03 0.03 1</diffuse>
        </material>
      </visual>
      <visual name="green">
        <pose>0 0.34 0 0 0 0</pose>
        <geometry>
          <sphere><radius>0.035</radius></sphere>
        </geometry>
        <material>
          <ambient>0.03 0.9 0.03 1</ambient>
          <diffuse>0.03 0.9 0.03 1</diffuse>
        </material>
      </visual>
      <visual name="blue">
        <pose>0.19 0.17 0 0 0 0</pose>
        <geometry>
          <sphere><radius>0.035</radius></sphere>
        </geometry>
        <material>
          <ambient>0.03 0.03 0.9 1</ambient>
          <diffuse>0.03 0.03 0.9 1</diffuse>
        </material>
      </visual>
      <visual name="yellow">
        <pose>0.19 0.34 0 0 0 0</pose>
        <geometry>
          <sphere><radius>0.035</radius></sphere>
        </geometry>
        <material>
          <ambient>0.9 0.9 0.03 1</ambient>
          <diffuse>0.9 0.9 0.03 1</diffuse>
        </material>
      </visual>
    </link>
  </model>
</sdf>
